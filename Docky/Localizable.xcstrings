    },
    "Shows a fullscreen launcher with all installed apps on a blurred backdrop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un lanzador a pantalla completa con todas las apps instaladas sobre un fondo desenfocado."
          }
        }
      }
    },
    "Shows a strip for switching profiles. It stays hidden while there's only one profile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una franja para cambiar de perfil. Permanece oculta mientras haya un solo perfil."
          }
        }
      }
    },
    "Shows an app folder's open apps together on the taskbar, and lets the folder show how many are open." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
