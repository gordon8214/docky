    },
    "Shows counts like Mail's unread total on app buttons. Needs Accessibility access." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra contadores, como los mensajes sin leer de Mail, en los botones de las apps. Requiere acceso de Accesibilidad."
          }
        }
      }
    },
    "Shows CPU, memory, and network activity at a glance." : {
      "localizations" : {
